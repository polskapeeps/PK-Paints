{
  "name": "pk-paints",
  "version": "1.0.0",
  "description": "PK Paints & Renovations website",
  "scripts": {
    "predev": "npm run generate:gallery",
    "dev": "vite",
    "generate:gallery": "node scripts/generate-gallery-assets.js",
    "build": "npm run generate:gallery && vite build && npm run check:site",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler dev --local --env preview",
    "check:cloudflare": "node scripts/check-cloudflare.mjs",
    "deploy:cloudflare:preview": "npm run build && wrangler deploy --env preview",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "test:cloudflare": "node --test tests/cloudflare.integration.mjs",
    "verify:cloudflare": "npm test && npm run build && npm run test:cloudflare && npm run audit:deps && wrangler deploy --env preview --dry-run --outdir .wrangler/dry-run",
    "check:site": "node scripts/check-built-site.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "lint": "eslint .",
    "test": "npm run lint && node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polskapeeps/PK-Paints.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "bugs": {
    "url": "https://github.com/polskapeeps/PK-Paints/issues"
  },
  "homepage": "https://pkpaintsrenovations.com/",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "wrangler": "4.149.0"
  }
}
