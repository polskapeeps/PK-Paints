{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pk-paints-renovations",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for branches and pull requests.
  // Previews inherit the top-level assets and compatibility settings.
  "previews": {},
  // Cloudflare creates and manages the apex DNS record for this custom domain.
  // www redirects to the apex with a zone Redirect Rule, outside the Worker.
  "routes": [{ "pattern": "pkpaintsrenovations.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Keep all existing pages and images on free, unlimited static asset serving.
    "run_worker_first": ["/api", "/api/*"]
  },
  "env": {
    "preview": {
      "name": "pk-paints-renovations-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": ["/api", "/api/*"]
      }
    }
  }
}
